# Copiar como ".env" en la misma carpeta que Consultor_db_v5.py (o que el .exe si se empaqueta).
# NUNCA subir el .env real al repositorio.

# --- Base de datos MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_bd
DB_PASSWORD=contraseña_bd
DB_NAME=nombre_bd
DB_CHARSET=utf8mb4

# --- Servidor SMTP (ejemplo Gmail con contraseña de aplicación) ---
SMTP_SERVER=smtp.gmail.com
# 587 = STARTTLS, 465 = SSL directo
SMTP_PORT=587
SMTP_USER=cuenta@gmail.com
SMTP_PASS=contraseña_de_aplicacion
